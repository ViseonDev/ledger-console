# cp .env.example .env

# Where the ledger lives. Defaults to the fixture server. Leave it empty to
# make every request same-origin (vite proxy in dev, reverse proxy in prod).
VITE_LEDGER_URL=http://localhost:8022

# Journal polling. Backs off to the max after a quiet minute.
VITE_POLL_INTERVAL_MS=2000
VITE_POLL_MAX_INTERVAL_MS=10000

# Entries kept in memory per account before the oldest get dropped.
VITE_JOURNAL_BUFFER=5000

# Entries per request. The fixture caps this at 500.
VITE_PAGE_SIZE=200

# Only used by `npm run dev` when VITE_LEDGER_URL is empty: where vite
# proxies /v1 and /readyz to. Handy for a local ledger-core, which sends no
# CORS headers.
LEDGER_PROXY_TARGET=http://localhost:8080

# Fixture server (ignored when pointing at a real ledger)
FIXTURE_PORT=8022
FIXTURE_SEED=20260914
# How often the fixture posts a random transaction. 0 = frozen, which is
# what the contract suite wants.
FIXTURE_ENTRY_INTERVAL_MS=1500
